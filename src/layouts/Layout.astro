---
import "../styles/reset.css";
import Head from "../components/Head.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <Head title={title} description={description} />
  </head>
  <body>
    <main>
      <slot />
      <div class="layout-footer">
        <p>
         An integrative conceptual framework for understanding effective cognitive bandwidth in modern environments. While the term itself is not yet formally established in scientific taxonomy, it synthesizes validated research from cognitive psychology, neuroscience, and behavioral economics.
        </p>
        <p>
          The concept is presented as a heuristic model intended to encourage interdisciplinary dialogue rather than replace established constructs such as working memory capacity, cognitive load, or executive control.
        </p>
        <p>
          Future research may formalize measurable indices of brainwidth, particularly in contexts involving digital overload, multitasking, and cognitive sustainability.
        </p>
        <p>© {new Date().getFullYear()} — All rights reserved. </p>
      </div>
    </main>
  </body>
</html>
